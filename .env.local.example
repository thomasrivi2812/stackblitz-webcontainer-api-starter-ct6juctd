# Copie ce fichier en `.env.local` et renseigne l'URL de ton endpoint WordPress GraphQL.
# Tant que cette variable est vide, le site affiche des données d'exemple
# (en dev uniquement : en production, l'absence de WordPress fait échouer le build).
#
# Exemple avec InstaWP :
# WORDPRESS_GRAPHQL_ENDPOINT=https://ton-site.instawp.xyz/graphql

WORDPRESS_GRAPHQL_ENDPOINT=https://ndc-site-test.instawp.site/graphql

# Secret partagé pour la revalidation à la demande (/api/revalidate),
# appelé par WordPress au save_post. Doit être identique côté WP.
REVALIDATE_SECRET=change-moi-un-secret-long

# Mode « édition temps réel » : mets WP_LIVE=1 (côté Vercel) pendant que tu
# édites du contenu WordPress → les pages ne sont plus mises en cache (mise à
# jour instantanée). Retire-le (ou =0) quand tu as fini → cache ISR de 5 min.
# (Nécessite un redéploiement pour prendre effet.)
WP_LIVE=0

# Données d'exemple en production : par défaut, si WordPress est injoignable ou
# en erreur, la page n'est PAS régénérée (Next garde la dernière version valide)
# et le build échoue. WP_SAMPLE_FALLBACK=1 réautorise les données d'exemple
# (démo, StackBlitz) — à ne jamais activer sur le site public.
# WP_SAMPLE_FALLBACK=1

# Nombre de proxys de confiance devant Next (nginx, load balancer…) : sert à
# lire la vraie IP du visiteur dans X-Forwarded-For (limite d'envois des
# formulaires). 1 = un seul nginx devant le serveur Node (cas standard).
# TRUSTED_PROXY_HOPS=1

# --- Captcha ALTCHA (protection des formulaires, auto-hébergé) --------------
# Actif par défaut, sans compte ni service tiers. Secret de signature des défis :
# facultatif sur un seul serveur (généré au démarrage), OBLIGATOIRE et
# identique partout si plusieurs instances servent le site.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ALTCHA_HMAC_SECRET=...
# Le calcul côté navigateur exige HTTPS (ou localhost). Pour une recette servie
# en http simple, couper le captcha : ALTCHA_DISABLED=1 (jamais en prod).
# ALTCHA_DISABLED=1

# --- CMP Didomi (bannière cookies / gestion du consentement) -----------------
# Console Didomi (https://console.didomi.io) → ton organisation → SDK web :
# récupère la clé API publique. Sans cette variable, aucune bannière ni script
# Didomi n'est chargé (le site reste utilisable, sans cookies tiers).
# NEXT_PUBLIC_DIDOMI_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NEXT_PUBLIC_DIDOMI_NOTICE_ID=XXXXXXX  # optionnel : si plusieurs notices
