# Copie ce fichier en `.env.local` et renseigne l'URL de ton endpoint WordPress GraphQL.
# Tant que cette variable est vide, le site affiche des données d'exemple.
#
# Exemple avec InstaWP :
# WORDPRESS_GRAPHQL_ENDPOINT=https://ton-site.instawp.xyz/graphql

WORDPRESS_GRAPHQL_ENDPOINT=https://ndc-site-test.instawp.site/graphql

# Secret partagé pour la revalidation à la demande (/api/revalidate),
# appelé par WordPress au save_post. Doit être identique côté WP.
REVALIDATE_SECRET=change-moi-un-secret-long

# Mode « édition temps réel » : mets WP_LIVE=1 (côté Vercel) pendant que tu
# édites du contenu WordPress → les pages ne sont plus mises en cache (mise à
# jour instantanée). Retire-le (ou =0) quand tu as fini → cache ISR de 5 min.
# (Nécessite un redéploiement pour prendre effet.)
WP_LIVE=0
